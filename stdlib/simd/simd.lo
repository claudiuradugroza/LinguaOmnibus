#lingua: EN
// std.simd — SIMD vector operations
//
// Part of Lingua Omnibus Standard Library.
// Types: f32x4, f32x8, f64x2, i32x4, i32x8, i64x2

import std.core

// Extern declarations for SIMD intrinsics (implemented in kernels.c / asm)
extern function simd_add_f32x4(a: f32x4, b: f32x4) returns f32x4
extern function simd_mul_f32x4(a: f32x4, b: f32x4) returns f32x4
extern function simd_sub_f32x4(a: f32x4, b: f32x4) returns f32x4
extern function simd_load_f32x4(ptr: int32) returns f32x4
extern function simd_store_f32x4(ptr: int32, v: f32x4) returns Unit
extern function simd_broadcast_f32(x: f32) returns f32x4

// Public wrappers
pub function add_f32x4(a: f32x4, b: f32x4) returns f32x4:
    return simd_add_f32x4(a, b)

pub function mul_f32x4(a: f32x4, b: f32x4) returns f32x4:
    return simd_mul_f32x4(a, b)

pub function sub_f32x4(a: f32x4, b: f32x4) returns f32x4:
    return simd_sub_f32x4(a, b)

pub function load_f32x4(ptr: int32) returns f32x4:
    return simd_load_f32x4(ptr)

pub function broadcast_f32(x: f32) returns f32x4:
    return simd_broadcast_f32(x)