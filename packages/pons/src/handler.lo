#lingua: EN
// handler.lo — Handler trait
//
// Part of pons (RFC-0002).
// Spec target: spec-0.1
// Dependencies: request.lo, response.lo
//
// See: rfcs/0002-pons-web-framework.md §4.2

import std.io

// ─────────────────────────────────────────────────────────────
// Public types
// ─────────────────────────────────────────────────────────────

/// Handler function type.
pub type Handler = String

// ─────────────────────────────────────────────────────────────
// Public functions
// ─────────────────────────────────────────────────────────────

/// Create a handler from a function.
pub function make_handler(f: String) returns String:
    return f

/// Invoke a handler with a request.
pub function invoke(h: String, req: String) returns String:
    return h