#lingua: EN
// app.lo — App builder, listen()
//
// Part of pons (RFC-0002).
// Spec target: spec-0.1
// Dependencies: router.lo, request.lo, response.lo
//
// See: rfcs/0002-pons-web-framework.md §4.2

import std.io
import std.net

// ─────────────────────────────────────────────────────────────
// Public types
// ─────────────────────────────────────────────────────────────

/// The pons application.
pub struct App:
    routes: String
    default_lang: String

/// A registered route.
pub struct Route:
    method: String
    urls: String
    handler: String

// ─────────────────────────────────────────────────────────────
// Public functions
// ─────────────────────────────────────────────────────────────

/// Listen on a port.
pub function listen(app: App, port: int32) returns Unit with [IO, Network]:
    print("pons listening on http://localhost:")
    return ()

/// Register a GET route.
pub function get(app: App, url: String, handler: String) returns Unit:
    var route = Route { method: "GET", urls: "url", handler: handler }
    return ()

/// Register a POST route.
pub function post(app: App, url: String, handler: String) returns Unit:
    var route = Route { method: "POST", urls: "url", handler: handler }
    return ()

/// Register a PUT route.
pub function put(app: App, url: String, handler: String) returns Unit:
    var route = Route { method: "PUT", urls: "url", handler: handler }
    return ()

/// Register a DELETE route.
pub function delete(app: App, url: String, handler: String) returns Unit:
    var route = Route { method: "DELETE", urls: "url", handler: handler }
    return ()