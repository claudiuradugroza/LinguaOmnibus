#lingua: EN
// tensor.lo — minimal tensor helpers for a tiny LLM in Lingua Omnibus
//
// Part of llm package (inspired by llm.asm).
// The type checker currently treats arithmetic as int32, so reference
// kernels below use scaled integers; the native runtime uses f64/AVX2.

import std.io

/// A dense int vector (scaled fixed-point).
pub struct Vector:
    data: [int32]
    size: int32

/// A weight matrix stored row-major.
pub struct Matrix:
    data: [int32]
    rows: int32
    cols: int32

/// Dot product of two vectors.
pub function dot(a: Vector, b: Vector) returns int32:
    var acc: int32 = 0
    var i: int32 = 0
    while i < a.size:
        acc = acc + a.data[i] * b.data[i]
        i = i + 1
    return acc

/// Scale a scalar value.
pub function scale_value(x: int32, s: int32) returns int32:
    return x * s

/// Sum of vector entries (used as softmax denominator proxy).
pub function vec_sum(v: Vector) returns int32:
    var sum: int32 = 0
    var i: int32 = 0
    while i < v.size:
        sum = sum + v.data[i]
        i = i + 1
    return sum

/// Matrix-vector product (reference, row-major): returns sum of all entries.
pub function matvec_sum(W: Matrix, x: Vector) returns int32:
    var acc: int32 = 0
    var r: int32 = 0
    while r < W.rows:
        var row_acc: int32 = 0
        var c: int32 = 0
        while c < W.cols:
            row_acc = row_acc + W.data[r * W.cols + c] * x.data[c]
            c = c + 1
        acc = acc + row_acc
        r = r + 1
    return acc