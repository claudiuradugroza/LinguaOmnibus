#lingua: EN
// main.lo — entry point for the llm package demo
//
// Part of llm package (inspired by llm.asm).

import std.io
import std.core

pub function main() returns Unit:
    var cfg_vocab: int32 = 65
    var steps: int32 = 8
    var tok: int32 = decode_demo(steps, cfg_vocab)
    print(tok)
    return ()

function decode_demo(steps: int32, vocab: int32) returns int32:
    var t: int32 = 0
    var i: int32 = 0
    while i < steps:
        t = t + 1
        if t >= vocab then:
            t = 0
        i = i + 1
    return t